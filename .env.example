# =============================================================================
# PriceScan - Environment Configuration Example
# =============================================================================
# Скопируйте этот файл в .env и заполните реальными значениями
# cp .env.example .env

# =============================================================================
# DJANGO API SETTINGS
# =============================================================================

# Django секретный ключ (сгенерируется автоматически если не указан)
# SECRET_KEY=your-secret-key-here

# Режим отладки (True/False)
DEBUG=True

# Разрешенные хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DJANGO SUPERUSER
# =============================================================================

DJANGO_SUPERUSER_USER=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# =============================================================================
# DATABASE SETTINGS (PostgreSQL)
# =============================================================================

# Настройки базы данных PostgreSQL
POSTGRES_DB=pricescan_db
POSTGRES_USER=pricescan_user
POSTGRES_PASSWORD=pricescan_password
POSTGRES_HOST=db_pricescan
POSTGRES_PORT=5432

# =============================================================================
# REDIS SETTINGS
# =============================================================================

# Redis для Celery и кэширования
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =============================================================================
# TELEGRAM BOT SETTINGS
# =============================================================================

# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN=your-telegram-bot-token-here

# Сервисный токен для межсервисного взаимодействия
BOT_SERVICE_TOKEN=your-service-token-here

# URL API для бота (для Docker используйте внутренний адрес)
API_BASE_URL=http://web_pricescan/api/

# Таймаут API запросов (секунды)
API_TIMEOUT=12

# Уровень логирования бота
BOT_LOG_LEVEL=INFO

# =============================================================================
# PARSER SETTINGS
# =============================================================================

# Базовый URL для парсинга
PARSER_BASE_URL=https://hobbygames.ru

# Максимальное количество повторных попыток
PARSER_MAX_RETRIES=3

# Таймаут запросов парсера (секунды)
PARSER_TIMEOUT=30

# Задержка между запросами (секунды)
PARSER_REQUEST_DELAY=0.5

# Уровень логирования парсеров
PARSER_LOG_LEVEL=INFO

# Директория для логов парсеров (опционально)
# PARSER_LOG_DIR=/app/logs

# =============================================================================
# PLAYWRIGHT SETTINGS
# =============================================================================

# Запуск браузера в headless режиме (true/false)
PARSER_HEADLESS=true

# Размер viewport браузера
PARSER_VIEWPORT_WIDTH=1366
PARSER_VIEWPORT_HEIGHT=900

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Для продакшена установите:
# DEBUG=False
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# POSTGRES_PASSWORD=strong-password-here
# BOT_SERVICE_TOKEN=strong-service-token-here
# SECRET_KEY=your-production-secret-key-here

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Кастомные настройки можно добавить здесь
# CUSTOM_SETTING=value
